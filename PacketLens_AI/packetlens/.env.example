# Copy this file to ".env" (same folder) and fill in your key to enable
# AI-generated (Claude API) plain-English packet explanations.
# Without this, PacketLens automatically uses free offline templates instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model (claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-sonnet-5
